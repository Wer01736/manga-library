{
  "manifest_version": 3,
  "name": "漫畫下載助手（Edge 測試版）",
  "version": "0.7.2",
  "description": "把 WNACG、18comic 或 nhentai 漫畫目錄頁送到本機漫畫下載器。",
  "incognito": "split",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://18comic.vip/*",
    "https://www.18comic.vip/*",
    "https://nhentai.net/*",
    "https://www.nhentai.net/*",
    "https://*.nhentai.net/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
    "js": ["library-bridge.js"],
    "run_at": "document_start"
  }],
  "action": { "default_title": "漫畫下載助手", "default_popup": "popup.html" }
}
